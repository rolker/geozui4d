<?xml version = '1.0'?>
<kdevelop>
  <general>
    <author>Roland Arsenault</author>
    <email>roland@ccom.unh.edu</email>
    <version>$VERSION$</version>
    <projectmanagement>KDevCustomProject</projectmanagement>
    <primarylanguage>C++</primarylanguage>
    <ignoreparts/>
    <projectdirectory>.</projectdirectory>
    <absoluteprojectpath>false</absoluteprojectpath>
    <description/>
    <versioncontrol>kdevsubversion</versioncontrol>
    <projectname>GeoZui4D</projectname>
    <defaultencoding/>
  </general>
  <kdevcustomproject>
    <run>
      <mainprogram>/home/roland/bin/GeoZui4D_d</mainprogram>
      <directoryradio>build</directoryradio>
      <customdirectory>/</customdirectory>
      <programargs/>
      <terminal>false</terminal>
      <autocompile>true</autocompile>
      <envvars/>
      <globaldebugarguments/>
      <globalcwd>/home/roland/work/ENC_ROOT/</globalcwd>
      <useglobalprogram>false</useglobalprogram>
      <autoinstall>false</autoinstall>
      <autokdesu>false</autokdesu>
    </run>
    <build>
      <buildtool>make</buildtool>
      <builddir/>
    </build>
    <make>
      <abortonerror>false</abortonerror>
      <numberofjobs>1</numberofjobs>
      <prio>0</prio>
      <dontact>false</dontact>
      <makebin/>
      <defaulttarget/>
      <makeoptions/>
      <selectedenvironment>default</selectedenvironment>
      <environments>
        <default/>
      </environments>
    </make>
    <filetypes>
      <filetype>*.java</filetype>
      <filetype>*.h</filetype>
      <filetype>*.H</filetype>
      <filetype>*.hh</filetype>
      <filetype>*.hxx</filetype>
      <filetype>*.hpp</filetype>
      <filetype>*.c</filetype>
      <filetype>*.C</filetype>
      <filetype>*.cc</filetype>
      <filetype>*.cpp</filetype>
      <filetype>*.c++</filetype>
      <filetype>*.cxx</filetype>
      <filetype>Makefile</filetype>
      <filetype>CMakeLists.txt</filetype>
    </filetypes>
    <blacklist>
      <path>gzmod/Makefile</path>
      <path>utilities/sock</path>
      <path>utilities/sock/Makefile</path>
      <path>utilities/sock/src</path>
      <path>utilities/sock/src/sock.h</path>
      <path>utilities/sock/src/test</path>
      <path>utilities/sock/src/test/test.cpp</path>
      <path>utilities/sock/src/UDPSocket.cpp</path>
      <path>utilities/sock/src/UDPSocket.h</path>
      <path>utilities/tests</path>
      <path>utilities/tests/Makefile</path>
      <path>utilities/tests/test-addresses.h</path>
      <path>win32</path>
      <path>win32/include</path>
      <path>win32/include/gdal</path>
      <path>win32/include/gdal/cpl_config.h</path>
      <path>win32/include/gdal/cpl_error.h</path>
      <path>win32/include/gdal/cpl_port.h</path>
      <path>win32/include/gdal/ogr_core.h</path>
      <path>win32/include/gdal/ogr_feature.h</path>
      <path>win32/include/gdal/ogr_geometry.h</path>
      <path>win32/include/gdal/ogrsf_frmts.h</path>
      <path>win32/include/gdal/ogr_spatialref.h</path>
      <path>win32/include/gdal/ogr_srs_api.h</path>
      <path>win32/include/inttypes.h</path>
      <path>win32/include/jconfig.h</path>
      <path>win32/include/jerror.h</path>
      <path>win32/include/jmorecfg.h</path>
      <path>win32/include/jpeglib.h</path>
      <path>win32/include/ogg</path>
      <path>win32/include/ogg/ogg.h</path>
      <path>win32/include/ogg/os_types.h</path>
      <path>win32/include/SDL</path>
      <path>win32/include/SDL/begin_code.h</path>
      <path>win32/include/SDL/close_code.h</path>
      <path>win32/include/SDL/SDL_active.h</path>
      <path>win32/include/SDL/SDL_audio.h</path>
      <path>win32/include/SDL/SDL_byteorder.h</path>
      <path>win32/include/SDL/SDL_cdrom.h</path>
      <path>win32/include/SDL/SDL_endian.h</path>
      <path>win32/include/SDL/SDL_error.h</path>
      <path>win32/include/SDL/SDL_events.h</path>
      <path>win32/include/SDL/SDL_getenv.h</path>
      <path>win32/include/SDL/SDL.h</path>
      <path>win32/include/SDL/SDL_joystick.h</path>
      <path>win32/include/SDL/SDL_keyboard.h</path>
      <path>win32/include/SDL/SDL_keysym.h</path>
      <path>win32/include/SDL/SDL_main.h</path>
      <path>win32/include/SDL/SDL_mixer.h</path>
      <path>win32/include/SDL/SDL_mouse.h</path>
      <path>win32/include/SDL/SDL_mutex.h</path>
      <path>win32/include/SDL/SDL_net.h</path>
      <path>win32/include/SDL/SDL_quit.h</path>
      <path>win32/include/SDL/SDL_rwops.h</path>
      <path>win32/include/SDL/SDL_sound.h</path>
      <path>win32/include/SDL/SDL_timer.h</path>
      <path>win32/include/SDL/SDL_types.h</path>
      <path>win32/include/SDL/SDL_version.h</path>
      <path>win32/include/SDL/SDL_video.h</path>
      <path>win32/include/smpeg</path>
      <path>win32/include/smpeg/MPEGfilter.h</path>
      <path>win32/include/smpeg/smpeg.h</path>
      <path>win32/include/tclDecls.h</path>
      <path>win32/include/tcl.h</path>
      <path>win32/include/tclPlatDecls.h</path>
      <path>win32/include/tkDecls.h</path>
      <path>win32/include/tk.h</path>
      <path>win32/include/tkIntXlibDecls.h</path>
      <path>win32/include/tkPlatDecls.h</path>
      <path>win32/include/tkTable.h</path>
      <path>win32/include/vorbis</path>
      <path>win32/include/vorbis/codec.h</path>
      <path>win32/include/vorbis/vorbisfile.h</path>
      <path>win32/include/X11</path>
      <path>win32/include/X11/Xatom.h</path>
      <path>win32/include/X11/Xfuncproto.h</path>
      <path>win32/include/X11/X.h</path>
      <path>win32/include/X11/Xlib.h</path>
      <path>win32/include/X11/Xutil.h</path>
      <path>GeoZui4D_v4_0a-2007-11-09</path>
      <path>GeoZui4D_v4_0a-2007-11-09/lib</path>
      <path>GeoZui4D_v4_0a-2007-11-09/lib/GeoZui4D</path>
      <path>GeoZui4D_v4_0a-2007-11-09/lib/GeoZui4D/tclLinkage.h</path>
      <path>utilities/Image</path>
      <path>utilities/Image/GznIO.cpp</path>
      <path>utilities/Image/GznIO.h</path>
      <path>utilities/Image/Image.cpp</path>
      <path>utilities/Image/Image.h</path>
      <path>utilities/Image/ImageIO.cpp</path>
      <path>utilities/Image/ImageIO.h</path>
      <path>utilities/Image/JpegIO.cpp</path>
      <path>utilities/Image/JpegIO.h</path>
      <path>utilities/Image/TiffIO.cpp</path>
      <path>utilities/Image/TiffIO.h</path>
    </blacklist>
    <other>
      <prio>0</prio>
      <otherbin/>
      <defaulttarget/>
      <otheroptions/>
      <selectedenvironment>default</selectedenvironment>
      <environments>
        <default/>
      </environments>
    </other>
  </kdevcustomproject>
  <kdevdebugger>
    <general>
      <dbgshell/>
      <programargs/>
      <gdbpath/>
      <configGdbScript/>
      <runShellScript/>
      <runGdbScript/>
      <breakonloadinglibs>true</breakonloadinglibs>
      <separatetty>false</separatetty>
      <floatingtoolbar>false</floatingtoolbar>
      <raiseGDBOnStart>false</raiseGDBOnStart>
    </general>
    <display>
      <staticmembers>false</staticmembers>
      <demanglenames>true</demanglenames>
      <outputradix>10</outputradix>
    </display>
  </kdevdebugger>
  <kdevdoctreeview>
    <ignoretocs>
      <toc>ada</toc>
      <toc>ada_bugs_gcc</toc>
      <toc>bash</toc>
      <toc>bash_bugs</toc>
      <toc>clanlib</toc>
      <toc>fortran_bugs_gcc</toc>
      <toc>gnome1</toc>
      <toc>gnustep</toc>
      <toc>gtk</toc>
      <toc>gtk_bugs</toc>
      <toc>haskell</toc>
      <toc>haskell_bugs_ghc</toc>
      <toc>java_bugs_gcc</toc>
      <toc>java_bugs_sun</toc>
      <toc>kde2book</toc>
      <toc>opengl</toc>
      <toc>pascal_bugs_fp</toc>
      <toc>php</toc>
      <toc>php_bugs</toc>
      <toc>perl</toc>
      <toc>perl_bugs</toc>
      <toc>python</toc>
      <toc>python_bugs</toc>
      <toc>qt-kdev3</toc>
      <toc>ruby</toc>
      <toc>ruby_bugs</toc>
      <toc>sdl</toc>
      <toc>sw</toc>
      <toc>w3c-dom-level2-html</toc>
      <toc>w3c-svg</toc>
      <toc>w3c-uaag10</toc>
      <toc>wxwidgets_bugs</toc>
    </ignoretocs>
    <ignoreqt_xml>
      <toc>Guide to the Qt Translation Tools</toc>
      <toc>Qt Assistant Manual</toc>
      <toc>Qt Designer Manual</toc>
      <toc>Qt Reference Documentation</toc>
      <toc>qmake User Guide</toc>
    </ignoreqt_xml>
    <ignoredoxygen>
      <toc>KDE Libraries (Doxygen)</toc>
    </ignoredoxygen>
  </kdevdoctreeview>
  <kdevfilecreate>
    <filetypes/>
    <useglobaltypes>
      <type ext="ui" />
      <type ext="cpp" />
      <type ext="h" />
    </useglobaltypes>
  </kdevfilecreate>
  <kdevcppsupport>
    <references/>
    <codecompletion>
      <includeGlobalFunctions>true</includeGlobalFunctions>
      <includeTypes>true</includeTypes>
      <includeEnums>true</includeEnums>
      <includeTypedefs>false</includeTypedefs>
      <automaticCodeCompletion>true</automaticCodeCompletion>
      <automaticArgumentsHint>true</automaticArgumentsHint>
      <automaticHeaderCompletion>true</automaticHeaderCompletion>
      <codeCompletionDelay>250</codeCompletionDelay>
      <argumentsHintDelay>400</argumentsHintDelay>
      <headerCompletionDelay>250</headerCompletionDelay>
      <showOnlyAccessibleItems>false</showOnlyAccessibleItems>
      <completionBoxItemOrder>0</completionBoxItemOrder>
      <howEvaluationContextMenu>true</howEvaluationContextMenu>
      <showCommentWithArgumentHint>true</showCommentWithArgumentHint>
      <statusBarTypeEvaluation>false</statusBarTypeEvaluation>
      <namespaceAliases>std=_GLIBCXX_STD;__gnu_cxx=std</namespaceAliases>
      <processPrimaryTypes>true</processPrimaryTypes>
      <processFunctionArguments>false</processFunctionArguments>
      <preProcessAllHeaders>false</preProcessAllHeaders>
      <parseMissingHeaders>false</parseMissingHeaders>
      <resolveIncludePaths>true</resolveIncludePaths>
      <alwaysParseInBackground>true</alwaysParseInBackground>
      <usePermanentCaching>true</usePermanentCaching>
      <alwaysIncludeNamespaces>false</alwaysIncludeNamespaces>
      <includePaths>.;</includePaths>
      <parseMissingHeadersExperimental>false</parseMissingHeadersExperimental>
      <resolveIncludePathsUsingMakeExperimental>false</resolveIncludePathsUsingMakeExperimental>
    </codecompletion>
    <creategettersetter>
      <prefixGet/>
      <prefixSet>set</prefixSet>
      <prefixVariable>m_,_</prefixVariable>
      <parameterName>theValue</parameterName>
      <inlineGet>true</inlineGet>
      <inlineSet>true</inlineSet>
    </creategettersetter>
    <qt>
      <used>false</used>
      <version>3</version>
      <root>/usr/share/qt3</root>
      <includestyle>3</includestyle>
      <designerintegration>EmbeddedKDevDesigner</designerintegration>
      <qmake>/usr/bin/qmake</qmake>
      <designer>/usr/bin/designer</designer>
      <designerpluginpaths/>
    </qt>
    <splitheadersource>
      <enabled>false</enabled>
      <synchronize>true</synchronize>
      <orientation>Vertical</orientation>
    </splitheadersource>
  </kdevcppsupport>
  <kdevfileview>
    <groups>
      <group pattern="SCons*t" name="Scons" />
      <hidenonprojectfiles>false</hidenonprojectfiles>
      <hidenonlocation>false</hidenonlocation>
    </groups>
    <tree>
      <hidepatterns>*.o,*.lo,CVS</hidepatterns>
      <hidenonprojectfiles>false</hidenonprojectfiles>
      <showvcsfields>false</showvcsfields>
    </tree>
  </kdevfileview>
  <cppsupportpart>
    <filetemplates>
      <interfacesuffix>.h</interfacesuffix>
      <implementationsuffix>.cpp</implementationsuffix>
    </filetemplates>
  </cppsupportpart>
  <ctagspart>
    <customArguments/>
    <customTagfilePath/>
  </ctagspart>
</kdevelop>
