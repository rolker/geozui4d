                            <object class="sizeritem">
                                <border>0</border>
                                <option>0</option>
                                <object class="wxCheckBox" name="watermarkCheckbox" base="EditCheckBox">
                                    <checked>1</checked>
                                    <label>Watermark</label>
                                    <events>
                                        <handler event="EVT_CHECKBOX">OnWatermarkModified</handler>
                                    </events>
                                </object>
                            </object>
                        </object>
                    </object>
                </object>
            </object>
        </object>
    </object>
</application>
