#------------------------------------------------------------------------------
# convertASCtoGUTM.tcl -- convert .asc files to GeoZui3D .gutm files.
#
# Created by mdp 07/2001
# Given GUI by mdp 11/29/2001
#------------------------------------------------------------------------------
global appdir
source "$appdir/scripts/support/scriptSupport.tcl"

#------------------------------------------------------------------------------
script convertASCtoGUTM {
	variable variables {filename	""					"Input file"			file
						outfilename	"converted.gutm"	"Output file"			text
						numCols		""					"# Columns"				number
						numRows		""					"# Rows"				number
						spacing		""					"Cell Size"				number
						minEasting	""					"Westernmost Easting"	number
						minNorthing	""					"Southernmost Northing"	number
					   }

	trace variable filename w [namespace code {set outfilename "[file rootname $filename].gutm";#}]

	conversionToplevel $variables $scriptName "Convert .asc file to .gutm file"

	#---Conversion procedure---
	proc convert {} {
		variable variables
		variable scriptName
		set depth 0

		foreach {var val lab type} $variables {
			variable $var
		}
		set infile [open "$filename" "r"]
		set outfile [open "$outfilename" "w"]
		set minDepth 0

		update

		#---pass 1: find minimum depth, row start/stop---
		for {set row 0} {$row < $numRows} {incr row} {
			set startedRow 0
			set startCol($row) 0
			set endCol($row) 0
			.$scriptName.status configure -text "Pass 1: Row $row"
			update
			for {set col 0} {$col < $numCols} {incr col} {
				set inline [gets $infile]
				if {[eof $infile] == 1} break
				if {$inline != "NaN"} {
					if {$startedRow == 0} {
						set startCol($row) $col
						set startedRow 1
					}
					scan $inline "%f" depth
					if {$depth < $minDepth} {set minDepth $depth}
					set endCol($row) [expr $col + 1]
				}
			}
			if {[eof $infile] == 1} break;
		}
		close $infile
		set infile [open "$filename" "r"]

		set minDepth [expr $minDepth - 10.0]
		#---pass 2: write the .gutm file---
		puts $outfile "%---Generated by convertASCtoGUTM.tcl---
BEGIN GUTM 1.0
COLS_ROWS $numCols $numRows
CELLSIZE $spacing
SHAPE PARTIAL
LOCAL_ORIGIN $minEasting $minNorthing $minDepth"

		for {set row 0} {$row < $numRows} {incr row} {
			.$scriptName.status configure -text "Pass 2: Row $row"
			update
			for {set col 0} {$col < $startCol($row)} {incr col} {
				gets $infile
			}
			puts $outfile "$startCol($row) $endCol($row)"
			for {} {$col < $endCol($row)} {incr col} {
				set inline [gets $infile]
				if {$inline == "NaN"} {
					puts $outfile "0"
				} else {
					scan $inline "%f" depth
					puts $outfile [expr $depth - $minDepth]
				}
			}
			for {} {$col < $numCols} {incr col} {
				gets $infile
			}
		}
		close $infile
		close $outfile
		.$scriptName.status configure -text "Ready"
	}
}