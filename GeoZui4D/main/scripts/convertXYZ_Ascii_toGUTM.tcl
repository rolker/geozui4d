#------------------------------------------------------------------------------
# convertXYZ_Ascii_toGUTM.tcl -- convert sparce ASCII files to GeoZui3D .gutm files.
#
# Created by mdp 07/2001
# Given GUI by mdp 12/07/2001
#------------------------------------------------------------------------------
global appdir
source "$appdir/scripts/support/scriptSupport.tcl"

#------------------------------------------------------------------------------
script convertXYZtoGUTM {
	variable variables {filename	""					"Input file"			file
						outfilename	"converted.gutm"	"Output file"			text
						numCols		""					"# Columns"				number
						numRows		""					"# Rows"				number
						spacing		""					"Row Cell Size"			number
						colSpacing	""					"Column Cell Size"		number
						invertDepth	""					"Invert Heights to Depths"	bool
					   }

	trace variable filename w [namespace code {set outfilename "[file rootname $filename].gutm";#}]

	conversionToplevel $variables $scriptName "Convert an ASCII XYZ file to .gutm file"

	#---Conversion procedure---
	proc convert {} {
		variable variables
		variable scriptName
		set depth 0

		foreach {var val lab type} $variables {
			variable $var
		}
		set infile [open "$filename" "r"]
		set outfile [open "$outfilename" "w"]

		update

		#---pass 1: find line characteristics---
		set inline [gets $infile]
		scan $inline "%f %f %f" minEasting minNorthing minDepth
		scan $inline "%f %f %f" easting northing depth
		for {set row 0} {$row < $numRows} {incr row} {
			.$scriptName.status configure -text "Pass 1: Row $row"
			update
			set depthMask($row) {}
			set lastEasting $easting
			if {$easting < $minEasting} {set minEasting $easting}
			for {set col 0} {$col < $numCols} {incr col} {
				if {$invertDepth == 1} {
					set depth [expr -$depth]
				}
				if {$depth < $minDepth} {set minDepth $depth}
				set diff [expr ($easting - $lastEasting) / $colSpacing]
				set numZeros [expr round($diff) - 1]
				for {set i 0} {$i < $numZeros} {incr i} {
					append depthMask($row) "0"
				}
				append depthMask($row) "1"
				set lastEasting $easting
				#Get new line
				set inline [gets $infile]
				if {[eof $infile] == 1} break
				scan $inline "%f %f %f" easting northing depth
				if {$easting < $lastEasting} break
			}
			if {[eof $infile] == 1} break;
		}
		if {$depth < $minDepth} {
			set minDepth $depth
		}
		close $infile
		set infile [open "$filename" "r"]

		set minDepth [expr $minDepth - 10.0]
		#---pass 2: write the .gutm file---
		puts $outfile "%---Generated by convertXYZ_Ascii_toGUTM.tcl---
BEGIN GUTM 1.0
COLS_ROWS $numCols $numRows
CELLSIZE $spacing
SHAPE PARTIAL
LOCAL_ORIGIN $minEasting $minNorthing $minDepth"

		set inline [gets $infile]
		scan $inline "%f %f %f" easting northing depth
		for {set row 0} {$row < $numRows} {incr row} {
			.$scriptName.status configure -text "Pass 2: Row $row"
			update
			set len [string length $depthMask($row)]
			set start [expr ($easting - $minEasting) / $colSpacing]
			set start [expr round($start)]
			puts $outfile "$start [expr $start + $len]"
			for {set i 0} {$i < $len} {incr i} {
				if {$invertDepth == 1} {
					set depth [expr -$depth]
				}
				if {[string index $depthMask($row) $i] == 0} {
					puts $outfile "0"
				} else {
					puts $outfile [expr $depth - $minDepth]
					set inline [gets $infile]
					if {[eof $infile] == 1} break
					scan $inline "%f %f %f" easting northing depth
				}
			}
		}
		close $infile
		close $outfile
		.$scriptName.status configure -text "Ready"
	}
}