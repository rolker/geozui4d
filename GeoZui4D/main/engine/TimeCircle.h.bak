class TimeCircle: public ToglWindow
{
public:
	TimeCircle();

	void Display();

protected:
	// togl stuff
	void Reshape();
	
	TimeControl *tc;
	int displayList, blackCircle;
//	virtual int HandleInput(unsigned int inputType, InputInfo *info);
	
};

#endif
