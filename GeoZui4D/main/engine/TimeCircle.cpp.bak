// TimeCircle.cpp
/*---------------------------------------------------------------------------*/
/** 
 *	This class creates a display window that is intended to make it easier for
 *	the user to see that they are speeding up or slowing down time as they
 *	zoom in and out of time.  At this point, this is very experimental.  Don't
 *	know yet if it will be worthwhile.
 *
 *	Created by mdp 4/5/2005
 */
/*---------------------------------------------------------------------------*/

#include "TimeCircle.h"
#include "TimeControl.h"
#include"MainWindow.h"
#include"Scene3D.h"

extern MainWindow *mainWindow;

/*---------------------------------------------------------------------------*/
TimeCircle::TimeCircle()
: ToglWindow("timecircle")
{
	int i, nsides = 60;
	float around, twopi = 6.28318f;

	tc = mainWindow->getScene3D()->timeControl;

	Tcl_Eval("togl .timecircle -depth true -stereo true -double true -sharecontext main -height 60 -ident timecircle; place .timecircle -x 590 -y 870 -width 100 -height 80");
//	Tcl_Eval("bind .timecontrol <MouseWheel> \"focus .timecontrol; if {%D > 0} {.timecontrol mouse %x %y %s 4 0} else {.timecontrol mouse %x %y %s 5 0}\"");
//	Tcl_Eval("bind .timecontrol <ButtonPress> \"focus .timecontrol; .timecontrol mouse %x %y %s %b 0\"");
//	Tcl_Eval("bind .timecontrol <ButtonRelease> \"focus .timecontrol; .timecontrol mouse %x %y %s %b 1\"");
//	Tcl_Eval("bind .timecontrol <Motion>        \".timecontrol motion %x %y %s 0\"");

//	windowMediator->PushWindow(this);

	displayList = glGenLists(1);
	glNewList(displayList,GL_COMPILE_AND_EXECUTE);
	glBegin(GL_QUAD_STRIP);
		for (i = 0; i <= nsides; i++)
		{
			around = i / (float)nsides;
			glColor3f(around, around, around);
			glVertex2f(0.0, 0.0);
			glVertex2f(sin(around * twopi), -cos(around * twopi));
		}
	glEnd();
	glEndList();

	blackCircle = glGenLists(1);
	glNewList(blackCircle,GL_COMPILE_AND_EXECUTE);
	glColor3f(0.0, 0.0, 0.0);
	glBegin(GL_QUAD_STRIP);
		for (i = 0; i <= nsides; i++)
		{
			around = i / (float)nsides;
			glVertex2f(0.0, 0.0);
			glVertex2f(sin(around * twopi), cos(around * twopi));
		}
	glEnd();
	glEndList();
}

/*---------------------------------------------------------------------------*/
void TimeCircle::Display()
{
	int i;
	double time, scale, factor, inverse;
	//amounts is a list of scales at which to draw circles, terminated by -1.
	double amounts[] = {31557600000.0 /*1000 years*/, 3155760000.0 /*100 years*/, 315576000.0 /*10 years*/, 31557600.0 /*1 year (365.25 days)*/, 2592000.0 /*30 days*/, 604800.0 /*one week*/, 86400.0, 14400.0, 3600.0, 600, 60.0, 10.0, 1.0, 0.1, 0.01, 0.001, -1.0};
	float offset = width / 2.0, voffset = height / 2.0;

	SetTogl(myTogl);
	glDrawBuffer(GL_BACK);
	glClearColor(0.0,0.0,0.0,0.0);
	glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
	glDepthFunc(GL_LEQUAL);
		
	glLineWidth(2.0);
	
	time = tc->getGZTime();
	scale = tc->getScale();

	//loop through various scales to see which should be shown
	for (i = 0; amounts[i] > 0; i++);
	for (i--; i >= 0; i--)
	{
		factor = scale / amounts[i];
		if (factor > 5.0 || factor < 0.001)
			continue;
		inverse = -360.0 / amounts[i];
		glPushMatrix();
		glTranslatef(offset, voffset, .5 - (i / 100.0));
		glRotatef(fmod(time, amounts[i]) * inverse, 0.0, 0.0, 1.0);
		factor = 100.0 * pow(factor, 0.5);
		glScalef(factor, factor, factor);
		glCallList(displayList);
		glPopMatrix();
	}
	//Draw the center black circle
/*	glPushMatrix();
	glTranslatef(offset, voffset, 0.5f);
		glScalef(10.0, 10.0, 10.0);
		glCallList(blackCircle);
	glPopMatrix();
*/	
	Togl_SwapBuffers(myTogl);
}

/*---------------------------------------------------------------------------*/
void TimeCircle::Reshape()
{
	ToglWindow::Reshape();
	glMatrixMode(GL_PROJECTION);
	glLoadIdentity();
	glOrtho(0,width,0,height,-1,1);
	glMatrixMode(GL_MODELVIEW);
	glLoadIdentity();

}

