/*!\file bluetooth.cpp
 *
 * This generates a socket connection to a bluetooth device, including device discovery.
 */

/* (c) University of New Hampshire, Center for Coastal and Ocean Mapping and NOAA/UNH
 * Joint Hydrographic Center, 2007.  All rights reserved.
